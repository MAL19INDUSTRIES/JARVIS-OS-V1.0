# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# Required for Google Gemini Live
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: choose from SUPPORTED_VOICE_NAMES in main.py (case-insensitive)
# Example: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
GEMINI_VOICE_NAME="puck"

# Optional Gmail Desktop OAuth client JSON. Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# Optional presentation model overrides
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional: trial/keyword runtime limit
# If JARVIS_TRIAL_KEYWORD is set to any non-empty string,
# Jarvis will run for JARVIS_RUNTIME_SECONDS (default: 3600).
#JARVIS_TRIAL_KEYWORD="trial"
#JARVIS_RUNTIME_SECONDS="3600"

# Optional: locked container requirements
#JARVIS_LOCKED_KEY_SECRET="expected_unlock_key_contents"
#JARVIS_LOCKED_VOLUME="NameOfVolumeUnderVolumes"

# Optional: for the local API (if you enable api.server)
#JARVIS_API_KEY="YOUR_PRIVATE_API_KEY"

# Hosted API (FastAPI + Postgres + Redis)
#DATABASE_URL="postgresql://jarvis:password@localhost:5432/jarvis"
#REDIS_URL="redis://localhost:6379/0"
#JWT_SECRET="generate-a-long-random-value"
#JARVIS_ENCRYPTION_KEY="generate-a-separate-long-random-value"
#CORS_ORIGINS="http://localhost:3000"
#JARVIS_ENV="development"
#AUTO_CREATE_TABLES="1"
#REDIS_REQUIRED="0"
#ACCESS_TOKEN_MINUTES="1440"
#JARVIS_CHAT_MODEL="gemini-2.5-flash"
# Optional for a public/mobile deployment. When set on the server, people can
# use JARVIS without bringing their own Gemini API key.
#JARVIS_SERVICE_GEMINI_KEY="YOUR_SERVER_GEMINI_API_KEY"
